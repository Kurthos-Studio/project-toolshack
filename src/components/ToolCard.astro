---
type Props = {
  title: string;
  href: string;
  description: string;
  category: string;
};

const { title, href, description, category } = Astro.props as Props;
---

<article class="tool-card">
  <p class="eyebrow">{category}</p>
  <h3><a href={href}>{title}</a></h3>
  <p>{description}</p>
  <a class="tool-card-link" href={href}>Open tool</a>
</article>
