---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { blogPosts } from '../../data/blog';
import { siteConfig } from '../../data/site';
import '../../styles/blog.css';

const POSTS_PER_PAGE = 5;

export async function getStaticPaths() {
  const postsPerPage = 5;
  const totalPages = Math.ceil(blogPosts.length / postsPerPage);
  return Array.from({ length: totalPages }, (_, i) => ({
    params: { page: String(i + 1) },
  }));
}

// Get page number from route parameter or default to 1
const currentPage = Math.max(1, parseInt(Astro.params.page || '1'));
const totalPages = Math.ceil(blogPosts.length / POSTS_PER_PAGE);

// Validate page number
if (currentPage > totalPages) {
  return Astro.redirect('/blog/');
}

// Sort posts by date (newest first)
const sortedPosts = blogPosts.sort(
  (a, b) => new Date(b.publishedDate).getTime() - new Date(a.publishedDate).getTime()
);

// Get posts for current page
const startIndex = (currentPage - 1) * POSTS_PER_PAGE;
const endIndex = startIndex + POSTS_PER_PAGE;
const postsForPage = sortedPosts.slice(startIndex, endIndex);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Toolshack Blog',
  description: 'Learn how to use online tools effectively and best practices for productivity.',
  url: `${siteConfig.url}/blog/`,
};
---

<BaseLayout
  title={`Blog | ${siteConfig.name}`}
  description="Learn how to use online tools effectively with our comprehensive guides and tutorials."
  schema={schema}
>
  <section class="hero">
    <p class="eyebrow">Learning hub</p>
    <h1>Guides & Tutorials</h1>
    <p class="lead">Master productivity tools with practical guides, best practices, and expert tips.</p>
  </section>

  <section class="blog-container">
    <div class="blog-grid">
      {
        postsForPage.map((post) => (
          <article class="blog-card">
            <div class="blog-card-header">
              <time class="blog-date" datetime={post.publishedDate}>
                {new Date(post.publishedDate).toLocaleDateString('en-US', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric',
                })}
              </time>
            </div>
            <h2 class="blog-title">
              <a href={`/blog/${post.slug}/`}>{post.title}</a>
            </h2>
            <p class="blog-excerpt">{post.excerpt}</p>
            <div class="blog-card-footer">
              <span class="blog-reading-time">{post.readingTime} min read</span>
              <a href={`/blog/${post.slug}/`} class="blog-link">Read More →</a>
            </div>
          </article>
        ))
      }
    </div>

    <aside class="blog-sidebar">
      <AdSlot label="Blog Ad" />
    </aside>
  </section>

  {
    totalPages > 1 && (
      <nav class="pagination" aria-label="Blog pagination">
        {currentPage > 1 && (
          <a href={currentPage === 2 ? '/blog/1/' : `/blog/${currentPage - 1}/`} class="pagination-link pagination-prev">
            ← Previous
          </a>
        )}

        <div class="pagination-numbers">
          {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
            <a
              href={`/blog/${page}/`}
              class={`pagination-number ${page === currentPage ? 'active' : ''}`}
              aria-current={page === currentPage ? 'page' : undefined}
            >
              {page}
            </a>
          ))}
        </div>

        {currentPage < totalPages && (
          <a href={`/blog/${currentPage + 1}/`} class="pagination-link pagination-next">
            Next →
          </a>
        )}
      </nav>
    )
  }
</BaseLayout>
