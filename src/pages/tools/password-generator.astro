---
import AdSlot from '../../components/AdSlot.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { wordList } from '../../data/word-list';
import { siteConfig } from '../../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Password Generator',
  applicationCategory: 'SecurityApplication',
  operatingSystem: 'Web',
  description: 'Generate secure passwords with custom length and character options.',
};
---

<BaseLayout title={`Password Generator | ${siteConfig.name}`} description="Generate passwords." schema={schema}>
  <section class="tool-page">
    <div class="hero compact">
      <p class="eyebrow">Security</p>
      <h1>Password Generator</h1>
    </div>

    <section class="content-card password-explainer">
      <p class="eyebrow">How to use</p>
      <h2>Generate and copy secure passwords quickly</h2>
      <p>Choose a type first. In <strong>Random characters</strong> mode, set the length, then include uppercase letters, lowercase letters, numbers, and your preferred symbol set.</p>
      <p>Switch to <strong>Word chain</strong> mode for passphrases. Set the number of words from 2 to 30 and generate readable chains separated by hyphens.</p>
      <p>The tool creates 10 unique results each run. Click any result to copy it, and use the strength and entropy chips to compare options before you save one in your password manager.</p>
      <h3>Why is this safe to use?</h3>
      <p>Passwords are generated in your browser using secure random values and are never sent to a server. Nothing is stored after you leave the page, so your generated passwords stay on your device unless you copy or save them. Generating 10 options at once also adds uncertainty for any service provider, because only you know which result you finally used.</p>
    </section>

    <AdSlot label="Ad" />

    <div class="tool-shell password-shell">
      <section class="tool-panel stack password-panel" data-password-tool>
        <form class="password-controls">
          <div class="field-grid password-grid">
            <label>
              Type
              <select data-mode>
                <option value="characters">Random characters</option>
                <option value="words">Word chain</option>
              </select>
            </label>
            <label data-length-control>
              Length
              <input type="range" min="8" max="32" value="18" data-length />
              <span class="field-hint"><strong data-length-value>18</strong> characters</span>
            </label>
          </div>

          <div class="field-grid password-grid password-word-grid" data-word-controls hidden>
            <label>
              Words
              <input type="range" min="2" max="30" value="8" data-word-count />
              <span class="field-hint"><strong data-word-count-value>8</strong> words</span>
            </label>
          </div>

          <div class="check-list password-options" data-character-controls>
            <label><input type="checkbox" checked data-uppercase /> A-Z</label>
            <label><input type="checkbox" checked data-lowercase /> a-z</label>
            <label><input type="checkbox" checked data-numbers /> 0-9</label>
          </div>

          <div class="field-grid password-grid password-single-field" data-character-controls>
            <label>
              Symbols
              <select data-symbol-mode>
                <option value="standard">Standard symbols</option>
                <option value="mild">Mild symbols</option>
                <option value="none">None</option>
              </select>
            </label>
          </div>

          <div class="tool-actions password-actions">
            <button type="button" class="primary" data-generate>Generate 10 passwords</button>
          </div>
        </form>

        <div class="result-panel password-results">
          <div class="result-meta">
            <span class="chip" data-strength>Strength: ready</span>
            <span class="chip" data-entropy>Entropy: 0 bits</span>
          </div>
          <div class="password-list" data-password-list></div>
          <p class="field-hint" data-copy-status>Click any password to copy it.</p>
        </div>
      </section>
    </div>

    <RelatedTools slot="afterAds" currentSlug="password-generator" />
  </section>

  <script is:inline define:vars={{ wordList }}>
    const root = document.querySelector('[data-password-tool]');

    if (root) {
      const lengthInput = root.querySelector('[data-length]');
      const lengthValue = root.querySelector('[data-length-value]');
      const modeSelect = root.querySelector('[data-mode]');
      const lengthControl = root.querySelector('[data-length-control]');
      const characterControls = root.querySelectorAll('[data-character-controls]');
      const wordControls = root.querySelector('[data-word-controls]');
      const wordCountInput = root.querySelector('[data-word-count]');
      const wordCountValue = root.querySelector('[data-word-count-value]');
      const symbolMode = root.querySelector('[data-symbol-mode]');
      const uppercase = root.querySelector('[data-uppercase]');
      const lowercase = root.querySelector('[data-lowercase]');
      const numbers = root.querySelector('[data-numbers]');
      const generateButton = root.querySelector('[data-generate]');
      const passwordList = root.querySelector('[data-password-list]');
      const strength = root.querySelector('[data-strength]');
      const entropy = root.querySelector('[data-entropy]');
      const copyStatus = root.querySelector('[data-copy-status]');
      const commonWordPool = wordList;

      const alphabets = {
        upper: 'ABCDEFGHJKLMNPQRSTUVWXYZ',
        lower: 'abcdefghijkmnopqrstuvwxyz',
        numbers: '23456789',
        mild: '!@#$%&*?',
        standard: '!@#$%^&*()-_=+[]{};:,.<>/?',
      };

      function secureRandom(max) {
        const array = new Uint32Array(1);
        crypto.getRandomValues(array);
        return array[0] % max;
      }

      function secureShuffle(text) {
        const characters = [...text];

        for (let index = characters.length - 1; index > 0; index -= 1) {
          const swapIndex = secureRandom(index + 1);
          [characters[index], characters[swapIndex]] = [characters[swapIndex], characters[index]];
        }

        return characters.join('');
      }

      function getPool() {
        let pool = '';

        if (uppercase.checked) pool += alphabets.upper;
        if (lowercase.checked) pool += alphabets.lower;
        if (numbers.checked) pool += alphabets.numbers;

        const symbols = symbolMode.value === 'none' ? '' : alphabets[symbolMode.value];
        pool += symbols;

        return pool || alphabets.lower;
      }

      function scorePassword(poolSize, length) {
        const entropyBits = Math.round(length * Math.log2(poolSize));

        if (entropyBits < 50) return ['Low', entropyBits];
        if (entropyBits < 75) return ['Good', entropyBits];
        return ['High', entropyBits];
      }

      function scoreWordChain(wordCount) {
        const entropyBits = Math.round(wordCount * Math.log2(commonWordPool.length));

        if (entropyBits < 30) return ['Low', entropyBits];
        if (entropyBits < 45) return ['Good', entropyBits];
        return ['High', entropyBits];
      }

      function getWordCount() {
        const parsed = Number.parseInt(wordCountInput.value, 10);

        if (!Number.isFinite(parsed)) return 8;

        return Math.min(30, Math.max(2, parsed));
      }

      function normalizeWordCountInput(strict = false) {
        const parsed = Number.parseInt(wordCountInput.value, 10);

        if (!Number.isFinite(parsed)) {
          if (strict) {
            wordCountInput.value = '8';
          }

          return 8;
        }

        const clamped = Math.min(30, Math.max(2, parsed));

        if (clamped !== parsed) {
          wordCountInput.value = String(clamped);
        }

        if (wordCountValue) {
          wordCountValue.textContent = String(clamped);
        }

        return clamped;
      }

      function generatePassword() {
        const length = Number(lengthInput.value);
        const pool = getPool();
        const selectedSets = [];

        if (uppercase.checked) selectedSets.push(alphabets.upper);
        if (lowercase.checked) selectedSets.push(alphabets.lower);
        if (numbers.checked) selectedSets.push(alphabets.numbers);

        const symbols = symbolMode.value === 'none' ? '' : alphabets[symbolMode.value];
        if (symbols) selectedSets.push(symbols);

        let password = selectedSets.map((set) => set[secureRandom(set.length)]).join('');

        while (password.length < length) {
          password += pool[secureRandom(pool.length)];
        }

        password = secureShuffle(password).split('').slice(0, length).join('');

        return password;
      }

      function generateWordChain() {
        const wordCount = getWordCount();
        const chosen = [];

        while (chosen.length < wordCount) {
          const word = commonWordPool[secureRandom(commonWordPool.length)];

          if (!chosen.includes(word)) {
            chosen.push(word);
          }
        }

        return chosen.join('-');
      }

      function renderPasswords() {
        const isWordMode = modeSelect.value === 'words';
        const length = Number(lengthInput.value);
        const wordCount = getWordCount();
        const pool = getPool();
        const generated = [];

        while (generated.length < 10) {
          const password = isWordMode ? generateWordChain() : generatePassword();
          if (!generated.includes(password)) {
            generated.push(password);
          }
        }

        const [label, entropyBits] = isWordMode ? scoreWordChain(wordCount) : scorePassword(pool.length, length);
        strength.textContent = `Strength: ${label}`;
        entropy.textContent = `Entropy: ${entropyBits} bits`;
        generateButton.textContent = isWordMode ? 'Generate 10 word chains' : 'Generate 10 passwords';
        passwordList.dataset.mode = isWordMode ? 'words' : 'characters';

        passwordList.innerHTML = '';
        const fragment = document.createDocumentFragment();

        generated.forEach((password) => {
          const item = document.createElement('button');
          item.type = 'button';
          item.className = 'password-item';
          item.dataset.password = password;

          const text = document.createElement('span');
          text.className = 'password-text';
          text.textContent = password;

          const copy = document.createElement('span');
          copy.className = 'password-copy';
          copy.textContent = 'Copy';

          item.append(text, copy);
          fragment.append(item);
        });

        passwordList.append(fragment);
      }

      function updateVisibleControls() {
        const isWordMode = modeSelect.value === 'words';

        wordControls.hidden = !isWordMode;
        lengthControl.hidden = isWordMode;

        characterControls.forEach((control) => {
          control.hidden = isWordMode;
        });
      }

      lengthInput.addEventListener('input', () => {
        lengthValue.textContent = lengthInput.value;
        renderPasswords();
      });

      modeSelect.addEventListener('change', () => {
        updateVisibleControls();
        renderPasswords();
      });

      wordCountInput.addEventListener('input', () => {
        normalizeWordCountInput();
        renderPasswords();
      });

      wordCountInput.addEventListener('change', () => {
        normalizeWordCountInput(true);
        renderPasswords();
      });

      symbolMode.addEventListener('change', renderPasswords);
      uppercase.addEventListener('change', renderPasswords);
      lowercase.addEventListener('change', renderPasswords);
      numbers.addEventListener('change', renderPasswords);

      generateButton?.addEventListener('click', renderPasswords);

      passwordList.addEventListener('click', async (event) => {
        const target = event.target instanceof Element ? event.target.closest('[data-password]') : null;

        if (!target) return;

        const value = target.dataset.password || '';
        await navigator.clipboard.writeText(value);
        copyStatus.textContent = 'Password copied.';
        setTimeout(() => {
          copyStatus.textContent = 'Click any password to copy it.';
        }, 1200);
      });

      updateVisibleControls();
      normalizeWordCountInput(true);
      renderPasswords();
    }
  </script>
</BaseLayout>
