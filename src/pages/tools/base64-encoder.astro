---
import AdSlot from '../../components/AdSlot.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { siteConfig } from '../../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Base64 Encoder/Decoder',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  description: 'Encode text and data to Base64, or decode Base64 strings.',
};
---

<BaseLayout title={`Base64 Encoder/Decoder | ${siteConfig.name}`} description="Encode and decode Base64 text easily." schema={schema}>
  <section class="tool-page">
    <div class="hero compact">
      <p class="eyebrow">Developer</p>
      <h1>Base64 Encoder/Decoder</h1>
    </div>

    <section class="content-card tool-explainer">
      <p class="eyebrow">How to use</p>
      <h2>Convert text and data to and from Base64 encoding</h2>
      <p>Paste text or Base64 to convert between formats. Base64 encoding is used in emails, APIs, data URIs, and authentication.</p>
      <p>Essential for developers working with APIs, image data, and secure data transmission.</p>
    </section>

    <AdSlot label="Ad" />

    <div class="tool-shell base64-shell">
      <section class="tool-panel stack" data-base64-tool>
        <label>
          Input
          <textarea data-input placeholder="Paste text or Base64 string here...">Hello, World!</textarea>
        </label>

        <div class="tool-actions">
          <button type="button" class="primary" data-encode>Encode</button>
          <button type="button" class="secondary" data-decode>Decode</button>
          <button type="button" class="secondary" data-copy>Copy</button>
        </div>

        <div class="result-panel">
          <p class="eyebrow">Output</p>
          <textarea data-output readonly placeholder="Encoded/decoded result will appear here..."></textarea>
          <p class="field-hint" data-message>Paste text and click Encode or Decode.</p>
        </div>
      </section>
    </div>

    <RelatedTools currentSlug="base64-encoder" />
  </section>

  <script is:inline>
    const root = document.querySelector('[data-base64-tool]');

    if (root) {
      const input = root.querySelector('[data-input]');
      const output = root.querySelector('[data-output]');
      const message = root.querySelector('[data-message]');
      const encodeBtn = root.querySelector('[data-encode]');
      const decodeBtn = root.querySelector('[data-decode]');
      const copyBtn = root.querySelector('[data-copy]');

      function encode() {
        try {
          const encoded = btoa(unescape(encodeURIComponent(input.value)));
          output.value = encoded;
          message.textContent = 'Encoded successfully.';
          copyBtn.disabled = false;
        } catch (e) {
          output.value = '';
          message.textContent = 'Error encoding: ' + (e instanceof Error ? e.message : 'Unknown error');
          copyBtn.disabled = true;
        }
      }

      function decode() {
        try {
          const decoded = decodeURIComponent(escape(atob(input.value)));
          output.value = decoded;
          message.textContent = 'Decoded successfully.';
          copyBtn.disabled = false;
        } catch (e) {
          output.value = '';
          message.textContent = 'Error decoding: ' + (e instanceof Error ? e.message : 'Unknown error');
          copyBtn.disabled = true;
        }
      }

      encodeBtn?.addEventListener('click', encode);
      decodeBtn?.addEventListener('click', decode);

      copyBtn?.addEventListener('click', async () => {
        await navigator.clipboard.writeText(output.value || '');
        message.textContent = 'Output copied.';
      });

      input?.addEventListener('input', () => {
        output.value = '';
        message.textContent = 'Paste text and click Encode or Decode.';
      });
    }
  </script>
</BaseLayout>
