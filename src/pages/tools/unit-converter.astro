---
import AdSlot from '../../components/AdSlot.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { siteConfig } from '../../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Unit Converter',
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  description: 'Convert common units across length, weight, and temperature.',
};
---

<BaseLayout title={`Unit Converter | ${siteConfig.name}`} description="Convert common units quickly." schema={schema}>
  <section class="tool-page">
    <div class="hero compact">
      <p class="eyebrow">Utility</p>
      <h1>Unit Converter</h1>
    </div>

    <section class="content-card tool-explainer">
      <p class="eyebrow">How to use</p>
      <h2>Convert everyday units in seconds</h2>
      <p>Select a category, enter a value, choose source and target units, then read the converted result.</p>
      <p>Great for shopping, travel, recipes, and quick calculations while working.</p>
    </section>

    <AdSlot label="Ad" />

    <div class="tool-shell word-shell">
      <section class="tool-panel stack" data-unit-tool>
        <div class="field-grid">
          <label>
            Category
            <select data-category>
              <option value="length">Length</option>
              <option value="weight">Weight</option>
              <option value="temperature">Temperature</option>
            </select>
          </label>
          <label>
            Value
            <input type="number" value="1" step="any" data-value />
          </label>
        </div>

        <div class="field-grid">
          <label>
            From
            <select data-from></select>
          </label>
          <label>
            To
            <select data-to></select>
          </label>
        </div>

        <div class="tool-actions">
          <button type="button" class="primary" data-swap>Swap units</button>
          <button type="button" class="secondary" data-copy>Copy result</button>
        </div>

        <div class="result-panel">
          <p class="eyebrow">Result</p>
          <div class="result-box" data-result>1</div>
          <p class="field-hint" data-detail>Conversion updates automatically.</p>
        </div>
      </section>
    </div>

    <RelatedTools slot="afterAds" currentSlug="unit-converter" />
  </section>

  <script is:inline>
    const root = document.querySelector('[data-unit-tool]');

    if (root) {
      const category = root.querySelector('[data-category]');
      const value = root.querySelector('[data-value]');
      const from = root.querySelector('[data-from]');
      const to = root.querySelector('[data-to]');
      const swap = root.querySelector('[data-swap]');
      const copy = root.querySelector('[data-copy]');
      const result = root.querySelector('[data-result]');
      const detail = root.querySelector('[data-detail]');

      const sets = {
        length: {
          meter: 1,
          kilometer: 1000,
          centimeter: 0.01,
          millimeter: 0.001,
          mile: 1609.344,
          yard: 0.9144,
          foot: 0.3048,
          inch: 0.0254,
        },
        weight: {
          kilogram: 1,
          gram: 0.001,
          pound: 0.45359237,
          ounce: 0.0283495231,
          ton: 1000,
        },
        temperature: {
          celsius: 'celsius',
          fahrenheit: 'fahrenheit',
          kelvin: 'kelvin',
        },
      };

      function populateUnits() {
        const selected = category.value;
        const units = Object.keys(sets[selected]);

        from.innerHTML = units.map((unit) => `<option value="${unit}">${unit}</option>`).join('');
        to.innerHTML = units.map((unit) => `<option value="${unit}">${unit}</option>`).join('');

        to.value = units[1] || units[0];
      }

      function convertTemperature(inputValue, fromUnit, toUnit) {
        let celsius = inputValue;

        if (fromUnit === 'fahrenheit') celsius = (inputValue - 32) * (5 / 9);
        if (fromUnit === 'kelvin') celsius = inputValue - 273.15;

        if (toUnit === 'fahrenheit') return celsius * (9 / 5) + 32;
        if (toUnit === 'kelvin') return celsius + 273.15;
        return celsius;
      }

      function formatNumber(number) {
        if (!Number.isFinite(number)) return '0';
        return Number(number.toPrecision(10)).toString();
      }

      function runConversion() {
        const selected = category.value;
        const inputValue = Number(value.value);

        if (!Number.isFinite(inputValue)) {
          result.textContent = '0';
          detail.textContent = 'Please enter a valid number.';
          return;
        }

        let converted = 0;

        if (selected === 'temperature') {
          converted = convertTemperature(inputValue, from.value, to.value);
        } else {
          const fromFactor = sets[selected][from.value];
          const toFactor = sets[selected][to.value];
          converted = (inputValue * fromFactor) / toFactor;
        }

        const formatted = formatNumber(converted);
        result.textContent = formatted;
        detail.textContent = `${formatNumber(inputValue)} ${from.value} = ${formatted} ${to.value}`;
      }

      category.addEventListener('change', () => {
        populateUnits();
        runConversion();
      });

      value.addEventListener('input', runConversion);
      from.addEventListener('change', runConversion);
      to.addEventListener('change', runConversion);

      swap.addEventListener('click', () => {
        const previous = from.value;
        from.value = to.value;
        to.value = previous;
        runConversion();
      });

      copy.addEventListener('click', async () => {
        await navigator.clipboard.writeText(result.textContent || '');
        detail.textContent = 'Result copied.';
      });

      populateUnits();
      runConversion();
    }
  </script>
</BaseLayout>
