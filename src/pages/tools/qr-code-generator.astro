---
import AdSlot from '../../components/AdSlot.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { siteConfig } from '../../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'QR Code Generator',
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  description: 'Generate QR codes for links and text instantly.',
};
---

<BaseLayout title={`QR Code Generator | ${siteConfig.name}`} description="Generate QR codes quickly." schema={schema}>
  <section class="tool-page">
    <div class="hero compact">
      <p class="eyebrow">Utility</p>
      <h1>QR Code Generator</h1>
    </div>

    <section class="content-card tool-explainer">
      <p class="eyebrow">How to use</p>
      <h2>Create a QR code for links, text, and quick sharing</h2>
      <p>Enter any URL or plain text, choose your QR code style, and optionally add a background image.</p>
      <p>Perfect for flyers, event signs, Wi-Fi notes, and mobile handoffs with custom branding.</p>
    </section>

    <AdSlot label="Ad" />

    <div class="tool-shell">
      <section class="tool-panel stack" data-qr-tool>
        <label>
          Content
          <textarea data-content placeholder="https://tools.kurthos.app">https://tools.kurthos.app</textarea>
        </label>

        <div class="field-grid">
          <label>
            QR Size
            <input type="range" min="160" max="512" step="16" value="256" data-size />
            <span class="field-hint"><strong data-size-value>256</strong> px</span>
          </label>
          <label>
            Format
            <select data-format>
              <option value="square" selected>Square Dots</option>
              <option value="rounded">Rounded Curves</option>
            </select>
            <span class="field-hint">QR code style</span>
          </label>
        </div>

        <label>
          Background Image (Optional)
          <input type="file" data-bg-upload accept="image/*" />
          <span class="field-hint">Upload an image to add as background (QR code will maintain readability)</span>
        </label>

        <div class="tool-actions">
          <button type="button" class="primary" data-generate>Generate QR</button>
          <button type="button" class="secondary" data-clear-bg>Clear Background</button>
          <a class="button secondary" data-download href="#" download="qr-code.png">Download PNG</a>
        </div>

        <p class="field-hint" data-status>Ready to generate QR code.</p>
      </section>

      <aside class="result-panel qr-preview">
        <p class="eyebrow">Preview</p>
        <canvas data-qr-canvas style="max-width: 100%; border: 1px solid var(--color-border); border-radius: 8px; display: block;"></canvas>
      </aside>
    </div>

    <RelatedTools slot="afterAds" currentSlug="qr-code-generator" />
  </section>

  <script is:inline>
    const root = document.querySelector('[data-qr-tool]');

    if (root) {
      const content = root.querySelector('[data-content]');
      const size = root.querySelector('[data-size]');
      const sizeValue = root.querySelector('[data-size-value]');
      const format = root.querySelector('[data-format]');
      const bgUpload = root.querySelector('[data-bg-upload]');
      const generate = root.querySelector('[data-generate]');
      const clearBg = root.querySelector('[data-clear-bg]');
      const download = root.querySelector('[data-download]');
      const status = root.querySelector('[data-status]');
      const canvas = document.querySelector('[data-qr-canvas]');

      let backgroundImage = null;

      function generateSquareDots(ctx, qrImage, px) {
        const tempCanvas = document.createElement('canvas');
        tempCanvas.width = px;
        tempCanvas.height = px;
        const tempCtx = tempCanvas.getContext('2d');
        tempCtx.drawImage(qrImage, 0, 0, px, px);
        
        ctx.drawImage(tempCanvas, 0, 0);
      }

      function generateRoundedCurves(ctx, qrImage, px) {
        const tempCanvas = document.createElement('canvas');
        tempCanvas.width = px;
        tempCanvas.height = px;
        const tempCtx = tempCanvas.getContext('2d');
        tempCtx.drawImage(qrImage, 0, 0, px, px);
        
        const imgData = tempCtx.getImageData(0, 0, px, px);
        const data = imgData.data;
        
        ctx.fillStyle = '#fff';
        ctx.fillRect(0, 0, px, px);
        ctx.fillStyle = '#000';
        
        const pixelSize = Math.max(1, Math.floor(px / 29));
        const radius = pixelSize / 2.2;
        
        for (let i = 0; i < data.length; i += 4) {
          const brightness = (data[i] + data[i + 1] + data[i + 2]) / 3;
          if (brightness < 128) {
            const pixelIndex = i / 4;
            const col = pixelIndex % px;
            const row = Math.floor(pixelIndex / px);
            const x = col;
            const y = row;
            
            ctx.beginPath();
            ctx.moveTo(x + radius, y);
            ctx.lineTo(x + 1 - radius, y);
            ctx.quadraticCurveTo(x + 1, y, x + 1, y + radius);
            ctx.lineTo(x + 1, y + 1 - radius);
            ctx.quadraticCurveTo(x + 1, y + 1, x + 1 - radius, y + 1);
            ctx.lineTo(x + radius, y + 1);
            ctx.quadraticCurveTo(x, y + 1, x, y + 1 - radius);
            ctx.lineTo(x, y + radius);
            ctx.quadraticCurveTo(x, y, x + radius, y);
            ctx.closePath();
            ctx.fill();
          }
        }
      }

      function applyContrastOverlay(ctx, width, height) {
        const imageData = ctx.getImageData(0, 0, width, height);
        const data = imageData.data;
        
        for (let i = 0; i < data.length; i += 4) {
          const r = data[i];
          const g = data[i + 1];
          const b = data[i + 2];
          
          const brightness = (r * 299 + g * 587 + b * 114) / 1000;
          
          if (brightness > 128) {
            data[i] = 255;
            data[i + 1] = 255;
            data[i + 2] = 255;
            data[i + 3] = 200;
          } else {
            data[i] = 0;
            data[i + 1] = 0;
            data[i + 2] = 0;
            data[i + 3] = 220;
          }
        }
        
        ctx.putImageData(imageData, 0, 0);
      }

      async function generateQR() {
        const text = (content.value || '').trim() || 'https://tools.kurthos.app';
        const px = parseInt(size.value) || 256;
        const selectedFormat = format.value || 'square';
        
        try {
          canvas.width = px;
          canvas.height = px;
          const ctx = canvas.getContext('2d');
          
          ctx.fillStyle = '#fff';
          ctx.fillRect(0, 0, px, px);
          
          if (backgroundImage) {
            ctx.drawImage(backgroundImage, 0, 0, px, px);
            applyContrastOverlay(ctx, px, px);
          }
          
          const qrApiUrl = 'https://api.qrserver.com/v1/create-qr-code/?size=' + px + 'x' + px + '&data=' + encodeURIComponent(text);
          const qrImg = new Image();
          qrImg.crossOrigin = 'anonymous';
          
          qrImg.onload = () => {
            if (selectedFormat === 'rounded') {
              generateRoundedCurves(ctx, qrImg, px);
            } else {
              generateSquareDots(ctx, qrImg, px);
            }
            
            const downloadUrl = canvas.toDataURL('image/png');
            download.href = downloadUrl;
            status.textContent = 'QR code generated. Ready to download.';
          };
          
          qrImg.onerror = () => {
            status.textContent = 'Error generating QR code. Please try again.';
          };
          
          qrImg.src = qrApiUrl;
        } catch (e) {
          status.textContent = 'Error: ' + (e instanceof Error ? e.message : 'Unknown error');
        }
      }

      bgUpload.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;
        
        const reader = new FileReader();
        reader.onload = (event) => {
          const img = new Image();
          img.onload = () => {
            backgroundImage = img;
            status.textContent = 'Background image loaded. Regenerating...';
            generateQR();
          };
          img.onerror = () => {
            status.textContent = 'Error loading image. Please try another file.';
          };
          img.src = event.target.result;
        };
        reader.readAsDataURL(file);
      });

      clearBg.addEventListener('click', () => {
        backgroundImage = null;
        bgUpload.value = '';
        status.textContent = 'Background cleared.';
        generateQR();
      });

      generate.addEventListener('click', generateQR);
      content.addEventListener('input', () => {
        status.textContent = 'Content changed. Generate to update.';
      });
      size.addEventListener('input', () => {
        sizeValue.textContent = size.value;
        status.textContent = 'Size changed. Generate to update.';
      });
      format.addEventListener('change', () => {
        status.textContent = 'Format changed. Generate to update.';
      });

      generateQR();
    }
  </script>
</BaseLayout>
