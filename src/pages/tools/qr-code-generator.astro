---
import AdSlot from '../../components/AdSlot.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { siteConfig } from '../../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'QR Code Generator',
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  description: 'Generate QR codes for links and text instantly.',
};
---

<BaseLayout title={`QR Code Generator | ${siteConfig.name}`} description="Generate QR codes quickly." schema={schema}>
  <section class="tool-page">
    <div class="hero compact">
      <p class="eyebrow">Utility</p>
      <h1>QR Code Generator</h1>
    </div>

    <section class="content-card tool-explainer">
      <p class="eyebrow">How to use</p>
      <h2>Create a QR code for links, text, and quick sharing</h2>
      <p>Enter any URL or plain text, adjust the size slider, and copy or download the generated code.</p>
      <p>Perfect for flyers, event signs, Wi-Fi notes, and simple mobile handoffs.</p>
    </section>

    <AdSlot label="Ad" />

    <div class="tool-shell">
      <section class="tool-panel stack" data-qr-tool>
        <label>
          Content
          <textarea data-content placeholder="https://tools.kurthos.app">https://tools.kurthos.app/tools/</textarea>
        </label>

        <div class="field-grid">
          <label>
            QR size
            <input type="range" min="160" max="512" step="16" value="256" data-size />
            <span class="field-hint"><strong data-size-value>256</strong> px</span>
          </label>
          <label>
            Image URL
            <input type="text" data-image-url readonly />
          </label>
        </div>

        <div class="tool-actions">
          <button type="button" class="primary" data-copy-url>Copy image URL</button>
          <a class="button secondary" data-download href="#" download="qr-code.png">Download PNG</a>
        </div>

        <p class="field-hint" data-copy-status>The code updates while you type.</p>
      </section>

      <aside class="result-panel qr-preview">
        <p class="eyebrow">Preview</p>
        <img data-qr-image alt="Generated QR code" />
      </aside>
    </div>

    <RelatedTools slot="afterAds" currentSlug="qr-code-generator" />
  </section>

  <script is:inline>
    const root = document.querySelector('[data-qr-tool]');

    if (root) {
      const content = root.querySelector('[data-content]');
      const size = root.querySelector('[data-size]');
      const sizeValue = root.querySelector('[data-size-value]');
      const imageUrl = root.querySelector('[data-image-url]');
      const copyUrl = root.querySelector('[data-copy-url]');
      const copyStatus = root.querySelector('[data-copy-status]');
      const qrImage = document.querySelector('[data-qr-image]');
      const download = root.querySelector('[data-download]');

      function buildUrl() {
        const text = (content.value || '').trim() || 'https://tools.kurthos.app';
        const px = Number(size.value) || 256;
        return `https://api.qrserver.com/v1/create-qr-code/?size=${px}x${px}&data=${encodeURIComponent(text)}`;
      }

      function render() {
        const url = buildUrl();
        sizeValue.textContent = size.value;
        imageUrl.value = url;
        qrImage.src = url;
        download.href = url;
      }

      content.addEventListener('input', render);
      size.addEventListener('input', render);

      copyUrl.addEventListener('click', async () => {
        await navigator.clipboard.writeText(imageUrl.value || '');
        copyStatus.textContent = 'Image URL copied.';
        setTimeout(() => {
          copyStatus.textContent = 'The code updates while you type.';
        }, 1200);
      });

      render();
    }
  </script>
</BaseLayout>
