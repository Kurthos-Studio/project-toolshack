---
import AdSlot from '../components/AdSlot.astro';
import ToolCard from '../components/ToolCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig, tools } from '../data/site';
import { blogPosts } from '../data/blog';

// Featured tools that should always be shown
const featuredSlugs = ['qr-code-generator', 'regex-tester', 'password-generator', 'color-picker'];
const featuredTools = tools.filter(t => featuredSlugs.includes(t.slug));

// Remaining tools to randomly select from
const remainingTools = tools.filter(t => !featuredSlugs.includes(t.slug));

// Shuffle function
function shuffleArray<T>(array: T[]): T[] {
  const arr = [...array];
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}

// Get 5 random tools from remaining tools
const randomTools = shuffleArray(remainingTools).slice(0, 5);

// Combine: featured tools + random tools
const homepageTools = [...featuredTools, ...randomTools];

// Get 3 random blog posts
const randomPosts = shuffleArray(blogPosts).slice(0, 3);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: siteConfig.url,
  description: siteConfig.description,
};
---

<BaseLayout title={`${siteConfig.name} | Tools`} description={siteConfig.description} schema={schema}>
  <section class="hero">
    <div class="hero-grid">
      <div>
        <p class="eyebrow">Overview</p>
        <h1>Useful tools that stay out of your way.</h1>
        <p class="lead">Pick a tool, use it, move on.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <div>
        <h2>Latest from the blog</h2>
        <p>Learn about the tools and concepts behind them</p>
      </div>
      <a href="/blog/" class="link-arrow">View all posts →</a>
    </div>
    <div class="blog-preview-grid">
      {randomPosts.map((post) => (
        <a href={`/blog/${post.slug}/`} class="blog-preview-card">
          <p class="eyebrow">{post.category}</p>
          <h3>{post.title}</h3>
          <p>{post.excerpt}</p>
          <span class="blog-meta">{post.readingTime} min read</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <div>
        <h2>Featured tools</h2>
        <p>Quick utility tools for everyday tasks</p>
      </div>
      <a href="/tools/" class="link-arrow">View all tools →</a>
    </div>
    <div class="tool-grid">
      {homepageTools.map((tool) => <ToolCard {...tool} />)}
    </div>
  </section>

  <section class="section tool-shell">
    <div class="content-card">
      <p class="eyebrow">Now</p>
      <h2>Fast, private, dependable.</h2>
      <div class="feature-grid">
        <div class="content-card"><h3>Fast</h3><p>Get what you need without waiting around.</p></div>
        <div class="content-card"><h3>Private</h3><p>Your input stays in your browser while you work.</p></div>
        <div class="content-card"><h3>Dependable</h3><p>Clean tools that do one job and do it well.</p></div>
      </div>
    </div>
    <AdSlot label="Ad" />
  </section>
</BaseLayout>
