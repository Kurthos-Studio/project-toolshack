---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';
---

<BaseLayout title={`Disclaimer | ${siteConfig.name}`} description="Disclaimer." showAds={false}>
  <section class="hero compact">
    <p class="eyebrow">Disclaimer</p>
    <h1>Disclaimer</h1>
  </section>

  <section class="section content-card">
    <p>
      The tools are provided as-is. Check results before relying on them.
    </p>
    <p>
      Use of this site is at your own discretion, and the operators are not liable for losses or
      claims arising from use of the tools.
    </p>
    <p>
      Site owner: Kurt Thomas Steinert, Fockestrasse 4, 04275 Leipzig, Germany.
      Contact email: admin@kurthos.com.
    </p>
  </section>
</BaseLayout>
